{
  "name": "dsh-dictation",
  "version": "0.1.0-beta.2",
  "description": "Editable local and desktop dictation for DeepSeek Harness",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dictation",
    "speech-to-text",
    "sensevoice",
    "paraformer",
    "nemotron"
  ],
  "author": "WSL043",
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/*.js",
    "lib/*.map",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "build": "tsdown --config tsdown.config.mjs",
    "test": "node --test tests/*.test.mjs",
    "check": "pnpm run test && pnpm run build && pnpm pack --pack-destination .artifacts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/WSL043/dsh-dictation.git"
  },
  "bugs": {
    "url": "https://github.com/WSL043/dsh-dictation/issues"
  },
  "homepage": "https://github.com/WSL043/dsh-dictation#readme",
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "dependencies": {
    "sherpa-onnx": "1.13.6"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "4.0.1 || 4.0.2",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2 || 0.1.2-alpha.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2 || 0.1.2-alpha.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": { "optional": true },
    "@deepseek-ai/dsh-client-locale": { "optional": true },
    "@deepseek-ai/dsh-client-ui-slots": { "optional": true },
    "@deepseek-ai/dsh-host-webserver": { "optional": true },
    "react": { "optional": true },
    "react-dom": { "optional": true }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.1",
    "@deepseek-ai/dsh-client-locale": "0.1.1-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.1-rc.2",
    "@deepseek-ai/dsh-host-webserver": "0.1.1-rc.2",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tsdown": "0.22.2"
  }
}
